<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>GDW Async Index Free</title>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="GDW\AsyncIndex\Block\Adminhtml\Index"
                   name="gdw.async.index"
                   template="GDW_AsyncIndex::index.phtml">
                <container name="gdw.async.index.history.actions"
                           as="history.actions"/>
                <uiComponent name="gdw_asyncindex_indexer_listing"
                             as="indexer.listing"/>
            </block>
            <block class="GDW\Core\Block\Adminhtml\View\PromotionalFooter"
                   name="gdw.async.index.promotional.footer"
                   template="GDW_Core::common/promotional_footer.phtml"
                   after="-"/>
        </referenceContainer>
    </body>
</page>

<script>
require(['jquery'], function ($) {
    'use strict';

    var statusUrl = <?= /* @noEscape */ json_encode($statusUrl) ?>;
    var scheduleUrl = <?= /* @noEscape */ json_encode($scheduleUrl) ?>;
    var formKey = <?= /* @noEscape */ json_encode($formKey) ?>;
    var activePolls = {};
    var indexerSelector = '[data-bind*="gdw_asyncindex_indexer_listing"] input[type="checkbox"]';

    function selectedIndexers() {
        return $(indexerSelector + ':checked').filter(function () {
            return this.value !== 'on';
        }).map(function () {
            return this.value;
        }).get();
    }

    function showMessage(message, isError) {
        $('#gdw-async-index-message')
            .toggleClass('message-error', !!isError)
            .toggleClass('message-success', !isError)
            .text(message)
            .prop('hidden', false);
    }

    function updateProgress(data) {
        var progress = Math.max(0, Math.min(100, parseInt(data.progress, 10) || 0));
        var status = data.status || '';
        var currentIndexer = data.current_indexer || '';

        $('#gdw-async-index-progress')
            .prop('hidden', false)
            .toggleClass('message-error', status === 'failed');
        $('#gdw-async-index-progress-value').text(progress + '%');
        $('#gdw-async-index-progress-bar')
            .css('width', progress + '%')
            .attr('aria-valuenow', progress);
        $('#gdw-async-index-progress-status').text(status);
        $('#gdw-async-index-progress-indexer').text(
            currentIndexer ? 'Indexer: ' + currentIndexer : ''
        );
        $('#gdw-async-index-progress-message').text(
            data.message || data.error_message || ''
        );
    }

    function poll(jobId) {
        if (activePolls[jobId]) {
            return;
        }
        activePolls[jobId] = window.setInterval(function () {
            $.getJSON(statusUrl, {job_id: jobId}, function (data) {
                var row = $('[data-job-id="' + jobId + '"]');
                if (!data.success) {
                    return;
                }
                row.find('.job-status').text(data.status);
                row.find('.job-progress').text(data.progress + '%');
                row.find('.job-message').text(data.message);
                updateProgress(data);
                if (data.status === 'completed' || data.status === 'failed') {
                    window.clearInterval(activePolls[jobId]);
                    delete activePolls[jobId];
                    showMessage(data.message || data.error_message, data.status === 'failed');
                }
            });
        }, 3000);
    }

    function schedule(actionType, indexersOverride) {
        var indexers = indexersOverride || selectedIndexers();
        if (!indexers.length) {
            showMessage('<?= $block->escapeJs(__('Select at least one indexer.')) ?>', true);
            return;
        }

        $.post(scheduleUrl, {
            form_key: formKey,
            indexers: indexers,
            action_type: actionType,
            priority: $('#gdw-async-index-priority').val() || 10
        }, function (data) {
            if (!data.success) {
                showMessage(data.message, true);
                return;
            }
            showMessage(data.message, false);
            updateProgress({
                status: 'pending',
                progress: 0,
                message: data.message,
                current_indexer: ''
            });
            var row = $('<tr>').attr('data-job-id', data.job_id);
            $('<td>').text(data.job_id).appendTo(row);
            $('<td>').text(actionType).appendTo(row);
            $('<td>').text(indexers.join(', ')).appendTo(row);
            $('<td>').addClass('job-status').text('pending').appendTo(row);
            $('<td>').addClass('job-progress').text('0%').appendTo(row);
            $('<td>').text(new Date().toISOString()).appendTo(row);
            $('<td>').text('-').appendTo(row);
            $('<td>').text('-').appendTo(row);
            $('<td>').text('-').appendTo(row);
            $('<td>').addClass('job-message').text(data.message).appendTo(row);
            $('<td>').text('').appendTo(row);
            $('#gdw-async-index-history').prepend(row);
            poll(data.job_id);
        }, 'json').fail(function (xhr) {
            showMessage(xhr.responseJSON && xhr.responseJSON.message
                ? xhr.responseJSON.message
                : 'Unable to queue the reindexing job.', true);
        });
    }

    $('#gdw-async-index-process').on('click', function () {
        schedule($('#gdw-async-index-action').val());
    });
    $('#gdw-async-index-full').on('click', function () {
        var allIndexers = $(indexerSelector).filter(function () {
            return this.value !== 'on';
        }).map(function () {
            return this.value;
        }).get();
        schedule('full', allIndexers);
    });
    $('#gdw-async-index-progress-close').on('click', function () {
        $('#gdw-async-index-progress').prop('hidden', true);
    });

    var activeProgress = $('#gdw-async-index-progress');
    var activeJobId = activeProgress.data('job-id');
    if (activeJobId) {
        updateProgress({
            status: activeProgress.data('status'),
            progress: activeProgress.data('progress'),
            message: activeProgress.data('message'),
            current_indexer: activeProgress.data('current-indexer')
        });
        poll(activeJobId);
    }
});
</script>
